# ==============================================================================
# IELTS Ultimate — Supabase & Google Authentication Environment Configuration
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to '.env.local' for local development.
# 2. Never commit '.env.local' or real API keys to Git.
# 3. For Google OAuth: Configure your Google Client ID and Client Secret directly
#    inside your Supabase Dashboard under: Authentication -> Providers -> Google.
# ==============================================================================

# --- SUPABASE PUBLIC CONFIGURATION (Frontend Accessible) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key

# Vite / fallback naming (also supported by the client initialization)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key

# --- SUPABASE SERVER-SIDE CONFIGURATION (Never expose to frontend) ---
# Used exclusively for server-side operations and running scripts/provision-admin.js
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_ADMIN_EMAIL=admin@ieltsultimate.edu

